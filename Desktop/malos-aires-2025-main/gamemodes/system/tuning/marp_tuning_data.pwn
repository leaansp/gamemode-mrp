Tuning_IsVehModelSituable(modelid)
{
	if(modelid == 595 || modelid == 590 || modelid == 586 || modelid == 581 || modelid == 570 || modelid == 569 || modelid == 538 || modelid == 537 || 
		modelid == 523 || modelid == 522 || modelid == 521 || modelid == 510 || modelid == 509 || modelid == 493 || modelid == 484 || 
		modelid == 481 || modelid == 473 || modelid == 472 || modelid == 468 || modelid == 463 || modelid == 462 || modelid == 461 || 
		modelid == 454 || modelid == 453 || modelid == 452 || modelid == 449 || modelid == 448 || modelid == 446 || modelid == 430) {
		return 0;
	}
	return 1;
}

Tuning_VehModelHasPaintJob(modelid)
{
	if(modelid == 483 || modelid == 534 || modelid == 535 || modelid == 536 || modelid == 558 || modelid == 559 || modelid == 560 || 
		modelid == 561 || modelid == 562 || modelid == 565 || modelid == 567 || modelid == 575 || modelid == 576)
			return 1;
			
	return 0;
}