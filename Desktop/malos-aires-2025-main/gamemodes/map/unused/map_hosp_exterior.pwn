hook OnGameModeInitEnded() {
	new gateid;

	gateid = Gate_Create(968,
				1147.03149, -1384.87317, 13.46000, 0.00000, -90.00000, 0.00000,
				1147.03149, -1384.87317, 13.46000, 0.00000, 0.00000, 0.00000,
				.worldid = -1, .speed = 0.25, .factionid = FAC_HOSP, .autoCloseTime = 4500);
	
	Gate_SetVehicleDetection(gateid, 1143.42, -1384.82, 13.79, .size = 8.0);

	return true;
}