hook OnGameModeInitEnded() {
	new gateid;

	/* Porton de garage */
	gateid = Gate_Create(3037,
				1589.7349, -1638.3240, 14.2713, 0.0000, 0.0000, 90.0000,
				1597.5810, -1638.3240, 14.2713, 0.0000, 0.0000, 90.0000,
				.worldid = -1, .speed = 1.8, .type = GATE_TYPE_FACTION, .extraid = FAC_PMA, .autoCloseTime = 6500, .staticObject = true);

	Gate_SetOnFootFrontDetection(gateid, 1580.7545, -1637.5853, 14.0566, 0.0000, 0.0000, 0.0000, .labelText = "Portón");
	Gate_SetOnFootBackDetection(gateid, 1592.6533, -1638.9816, 13.9047, 0.0000, 0.0000, 100.0000, .labelText = "Portón");
	Gate_SetVehicleDetection(gateid, 1588.5000, -1637.8700, 13.43, .size = 8.0);

	/* Barrera de garage */
	gateid = Gate_Create(968,
				1544.6923, -1630.9959, 13.1039, 0.0000, 90.0000, 90.0000,
				1544.6923, -1630.9239, 12.9779, 0.0000, 0.0000, 90.0000,
				.worldid = -1, .speed = 0.25, .type = GATE_TYPE_FACTION, .extraid = FAC_PMA, .autoCloseTime = 4500);

	Gate_SetVehicleDetection(gateid, 1544.6923, -1626.2200, 13.44, .size = 8.0);

	/* Estación de servicio */
	GasStation_Create(1573.8691, -1623.1239, 1573.6421, -1627.4196, 1565.9718, -1627.1779, 1565.7841, -1623.0706, .z = 13.38, .factionid = FAC_PMA); 
	return true;
}