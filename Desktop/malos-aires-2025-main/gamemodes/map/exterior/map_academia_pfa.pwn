hook OnGameModeInitEnded() {
	new gateid;

	gateid = Gate_Create(969,
				1137.801391, 1362.501342, 9.920168, 0.000000, 0.000000, -0.199999,
				1144.482543, 1362.478393, 9.920168, 0.000000, 0.000000, -0.199999, 
				.worldid = -1, .speed = 2, .type = GATE_TYPE_FACTION, .extraid = FAC_PMA, .autoCloseTime = 5000);
	
	Gate_SetVehicleDetection(gateid, 1142.0038,1362.8885,10.7135, .size = 8.0);

	gateid = Gate_Create(969,
				1063.134765, 1357.671630, 9.920168, 0.000000, 0.000000, -0.199999,
				1070.776000, 1357.645019, 9.920168, 0.000000, 0.000000, -0.199999, 
				.worldid = -1, .speed = 2, .type = GATE_TYPE_FACTION, .extraid = FAC_PMA, .autoCloseTime = 5000);
	
	Gate_SetVehicleDetection(gateid, 1067.5503,1358.0551,10.6797, .size = 8.0);

	return true;
}