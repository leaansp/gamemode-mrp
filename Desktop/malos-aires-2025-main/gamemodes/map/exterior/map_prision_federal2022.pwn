hook OnGameModeInitEnded() {
	new gateid;

	gateid = Gate_Create(19912,
				2698.332275, -2399.638427, 15.408094, 0.000000, 0.000000, 90.000000,
				2698.332275, -2384.327880, 15.408094, 0.000000, 0.000000, 90.000000,
				.worldid = -1, .speed = 2, .type = GATE_TYPE_FACTION, .extraid = FAC_PMA, .autoCloseTime = 8000);
	
	Gate_SetVehicleDetection(gateid, 2697.7881, -2405.2883, 13.5450, .size = 8.0);

	gateid = Gate_Create(19912,
				2720.546875, -2399.638427, 15.408094, 0.000000, 0.000000, 90.000000,
				2720.546875, -2384.153076, 15.408094, 0.000000, 0.000000, 90.000000,
