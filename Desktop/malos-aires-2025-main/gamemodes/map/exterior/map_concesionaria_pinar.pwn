hook RemoveMapsBuildings(playerid) //en caso de no tener Removes, Borrar este hook
{   
    RemoveBuildingForPlayer(playerid, 5722, 982.367, -1090.920, 28.921, 0.250);
    RemoveBuildingForPlayer(playerid, 5963, 982.367, -1090.920, 28.921, 0.250);
    RemoveBuildingForPlayer(playerid, 5876, 1022.530, -1096.369, 34.625, 0.250);
    RemoveBuildingForPlayer(playerid, 5873, 1022.510, -1078.890, 34.679, 0.250);
    RemoveBuildingForPlayer(playerid, 1287, 974.281, -1131.130, 23.312, 0.250);
	return true;
}

